{
  "name": "coucou-windows",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sounds:check": "node ../scripts/gen-sounds.mjs --check",
    "versions:check": "node ../scripts/check-versions.mjs",
    "browser-args:check": "node ../scripts/check-browser-args.mjs",
    "smoke:hook": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-hook.ps1",
    "smoke:app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-app.ps1",
    "sign:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-smoke.ps1",
    "verify:signature": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signature.ps1",
    "uat:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uat-install.ps1",
    "verify": "npm run versions:check && npm run browser-args:check && npm run typecheck && npm run test && npm run sounds:check",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p coucou-hook",
    "prebuild": "cargo build --release -p coucou-hook",
    "pack": "tauri build && node scripts/pack.mjs",
    "feed:updater": "node scripts/updater-feed.mjs",
    "feed:serve": "node scripts/serve-feed.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
